# Base URL API. Default same-origin lewat BFF; jangan arahkan langsung ke backend produksi.
VITE_API_BASE_URL=/

# true = pakai MSW (mock backend) di dev. Default aktif di mode dev.
VITE_ENABLE_MOCKS=true

# Role sesi mock: l1 | l2 | supervisor | admin
VITE_MOCK_ROLE=supervisor

# true = simulasi event SSE tiap 20 detik (hanya saat mock aktif)
VITE_MOCK_EVENTS=false
