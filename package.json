{
  "name": "crm-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=12.0.0"
  },
  "scripts": {
    "dev": "VITE_REMOTE_MODULES=crm_cs=http://localhost:5177/remoteEntry.js pnpm -r --parallel --no-bail --filter @crm/crm-console --filter @crm/crm-cs dev",
    "build": "pnpm --filter @crm/crm-console --filter @crm/crm-cs build",
    "preview": "pnpm --filter @crm/crm-console preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "pnpm --filter @crm/crm-console test:e2e",
    "size": "pnpm --filter @crm/crm-console size",
    "codegen:api": "pnpm --filter @crm/api-client codegen",
    "codegen:check": "pnpm codegen:api && git diff --exit-code packages/api-client/src/generated",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm size && pnpm codegen:check",
    "prepare": "husky",
    "new:module": "pnpm --filter @crm/crm-console new:module",
    "new:endpoint": "pnpm --filter @crm/crm-console new:endpoint",
    "poc:mfe": "VITE_REMOTE_MODULES=crm_cs=http://localhost:5177/remoteEntry.js,crm_finance=http://localhost:5174/remoteEntry.js,crm_investigator=http://localhost:5175/remoteEntry.js,crm_monitor=http://localhost:5176/remoteEntry.js pnpm -r --parallel --no-bail --filter @crm/crm-console --filter @crm/crm-cs --filter @crm/crm-finance --filter @crm/crm-investigator --filter @crm/crm-monitor dev",
    "test:e2e:mfe": "pnpm --filter @crm/crm-console test:e2e:mfe"
  },
  "devDependencies": {
    "@crm/config-eslint": "workspace:*",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "10.13.0",
    "husky": "9.1.7",
    "lint-staged": "16.4.0",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs}": [
      "eslint --fix --max-warnings=0 --no-warn-ignored",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml,css,html}": [
      "prettier --write"
    ]
  }
}
